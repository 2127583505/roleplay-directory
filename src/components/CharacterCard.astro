---
import Cover from './Cover.astro';
import { href } from '../consts';

interface Props {
  id: string;
  name: string;
  tagline: string;
  creator: string;
  tags?: string[];
  cover?: string | null;
  coverAlt?: string | null;
  coverStyle?: string | null;
  index?: number;
}

const {
  id,
  name,
  tagline,
  creator,
  tags = [],
  cover,
  coverAlt,
  coverStyle,
  index,
} = Astro.props;

// 标签最多显示 3 个，其余折叠成计数，避免卡片高度失控
const shown = tags.slice(0, 3);
const rest = tags.length - shown.length;
---

<article
  class="card"
  data-name={name}
  data-tagline={tagline}
  data-creator={creator}
  data-tags={tags.join(',')}
  data-index={index}
>
  <a class="card__link" href={href(`/c/${id}/`)}>
    <Cover
      id={id}
      name={name}
      cover={cover}
      coverAlt={coverAlt}
      coverStyle={coverStyle}
      ratio="4 / 5"
    />
    <div class="card__body">
      <h3 class="card__name">{name}</h3>
      <p class="card__tagline">{tagline}</p>
      {
        tags.length > 0 && (
          <ul class="card__tags">
            {shown.map((t) => (
              <li class="pill">{t}</li>
            ))}
            {rest > 0 && <li class="pill pill--accent">+{rest}</li>}
          </ul>
        )
      }
      <p class="card__byline">{creator}</p>
    </div>
  </a>
</article>

<style>
  .card {
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: var(--r-lg);
    overflow: hidden;
    transition: transform 0.22s ease, box-shadow 0.22s ease,
      border-color 0.22s ease;
  }

  .card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: var(--hairline-strong);
  }

  .card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 9px 9px 0;
  }

  .card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 14px 8px 16px;
  }

  .card__name {
    font-size: 19px;
    line-height: 1.3;
    color: var(--ink);
  }

  .card__tagline {
    margin-top: 6px;
    font-size: 13px;
    line-height: 1.6;
    color: var(--ink-muted);
    /* 固定两行，保证网格高度整齐 */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    list-style: none;
    padding: 0;
    margin: 12px 0 0;
  }

  .card__tags .pill {
    font-size: 11.5px;
    padding: 3px 9px;
  }

  .card__byline {
    margin-top: auto;
    padding-top: 14px;
    font-size: 11.5px;
    color: var(--ink-faint);
  }
</style>
