---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Cover from '../../components/Cover.astro';
import CharacterCard from '../../components/CharacterCard.astro';
import { SITE, SOURCE_LABELS, SPEC_LABELS, href, absUrl } from '../../consts';
import { buildPrompt } from '../../lib/prompt';

export async function getStaticPaths() {
  const entries = await getCollection('characters');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const c = entry.data;
const { Content } = await render(entry);

// 收录徽章：创作者可以把它贴在主页或社交账号上
const badgeImg = absUrl(`/badge/${entry.id}.svg`);
const badgeLink = absUrl(`/c/${entry.id}/`);
const badgeMd = `[![灯下收录](${badgeImg})](${badgeLink})`;

/**
 * 提示词：直接从条目里的 persona 生成。
 * 这是把角色带进豆包 / DeepSeek 的那一步 —— 对大多数用户来说，
 * 这比下载卡片文件有用得多。
 */
const cardPrompt = c.persona ? buildPrompt(c.name, c.persona) : null;

/** 站内生成的角色卡下载地址（有 persona 才有） */
const genCardUrl = c.persona ? absUrl(`/cards/${entry.id}.json`) : null;

const fmt = (d?: Date) =>
  d ? `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}` : null;

/** 同标签相关角色，用于继续发现 */
const all = await getCollection('characters');
const related = all
  .filter((e) => e.id !== entry.id)
  .map((e) => ({
    entry: e,
    score: e.data.tags.filter((t) => c.tags.includes(t)).length,
  }))
  .filter((x) => x.score > 0)
  .sort((a, b) => b.score - a.score)
  .slice(0, 4);

const issueUrl = `${SITE.repo}/issues/new?title=${encodeURIComponent(
  `[纠错] ${c.name}`,
)}&body=${encodeURIComponent(`角色卡页面：/c/${entry.id}/\n\n问题描述：\n`)}`;
---

<Base title={c.name} description={`${c.name} · ${c.tagline}`}>
  <article class="wrap detail">
    <nav class="crumb" aria-label="面包屑">
      <a href={href('/')}>全部角色</a>
      <span aria-hidden="true">/</span>
      <span>{c.name}</span>
    </nav>

    <div class="detail__grid">
      <!-- 左：封面 -->
      <div class="detail__side">
        <Cover
          id={entry.id}
          name={c.name}
          cover={c.cover}
          coverAlt={c.coverAlt}
          coverStyle={c.coverStyle}
          ratio="3 / 4"
          loading="eager"
        />

        <a class="btn btn--primary detail__cta" href={cardPrompt ? '#chat' : '#get'}>
          {cardPrompt ? '复制提示词，去聊天' : '获取这张角色卡'}
        </a>

        <dl class="facts">
          <div class="facts__row">
            <dt>创作者</dt>
            <dd>
              <a href={href(`/creator/${encodeURIComponent(c.creator)}/`)}>{c.creator}</a>
            </dd>
          </div>
          <div class="facts__row">
            <dt>版本</dt>
            <dd>v{c.version}</dd>
          </div>
          {
            c.updated && (
              <div class="facts__row">
                <dt>更新</dt>
                <dd>{fmt(c.updated)}</dd>
              </div>
            )
          }
          <div class="facts__row">
            <dt>规范</dt>
            <dd>{SPEC_LABELS[c.spec] ?? c.spec}</dd>
          </div>
          <div class="facts__row">
            <dt>授权</dt>
            <dd>{c.license}</dd>
          </div>
          {
            c.fandom && (
              <div class="facts__row">
                <dt>原作</dt>
                <dd>{c.fandom}</dd>
              </div>
            )
          }
        </dl>
      </div>

      <!-- 右：正文 -->
      <div class="detail__main">
        <header class="detail__head">
          <h1 class="detail__name">{c.name}</h1>
          <p class="detail__tagline">{c.tagline}</p>
          {
            c.tags.length > 0 && (
              <ul class="detail__tags">
                {c.tags.map((t) => (
                  <li class="pill">{t}</li>
                ))}
              </ul>
            )
          }
        </header>

        {
          c.greetingPreview && (
            <section class="opening">
              <p class="opening__label">开场白</p>
              <blockquote class="opening__quote">{c.greetingPreview}</blockquote>
              <p class="opening__note">
                节选。完整的开场白就写在下面那段话里 —— 复制过去，他会从这一幕开始。
              </p>
            </section>
          )
        }

        {
          cardPrompt && (
            <section class="block" id="chat">
              <h2 class="block__title">在豆包 / DeepSeek 里和他聊天</h2>
              <p class="block__text">
                不用装软件，不用下载文件。点下面这个按钮复制他的话，
                打开豆包或 DeepSeek 新建一个对话，粘贴，发送 ——
                他就会以这个身份，对你说第一句。
              </p>

              <div class="promptbox">
                <button class="btn btn--primary" type="button" data-prompt-copy>
                  复制提示词
                </button>
                <a class="btn btn--ghost" href={href('/use/')}>完整图文步骤</a>
              </div>

              <details class="promptdetails">
                <summary>先看看这段话里写了什么</summary>
                <pre class="promptdetails__pre"><code data-prompt-text>{cardPrompt}</code></pre>
              </details>

              <p class="pick__q">复制好了。接下来看你平时用哪个，我分开说：</p>

              <div class="pick">
                <button class="pick__btn is-on" type="button" data-app="deepseek">
                  我在用 DeepSeek
                </button>
                <button class="pick__btn" type="button" data-app="doubao">
                  我在用豆包
                </button>
              </div>

              <div class="howto" data-app-panel="deepseek">
                <ol class="minsteps">
                  <li>打开 DeepSeek，点「新对话」</li>
                  <li>长按输入框选「粘贴」（电脑上 Ctrl+V），发送</li>
                  <li>他会以 {c.name} 的身份回你第一句。之后正常聊就行</li>
                </ol>
                <p class="howto__note">
                  每开一个新对话都要重新粘一次。把「深度思考」关掉，他会更像在跟你聊天。
                </p>
              </div>

              <div class="howto" data-app-panel="doubao" hidden>
                <ol class="minsteps">
                  <li>
                    先直接粘一次：打开豆包，新建对话 → 粘贴 → 发送。<strong
                      >这一步任何版本都成立</strong
                    >
                  </li>
                  <li>
                    想以后不用再粘：进「智能体」广场，找「+ 创建 AI 智能体」，
                    名字填「{c.name}」
                  </li>
                  <li>
                    把刚才那段话<strong>整段</strong>粘进「设定描述」，点「完成」。
                    审核过后，从「我的 → 智能体」里就能找到他
                  </li>
                </ol>
                <p class="howto__note">
                  找不到「创建智能体」也没关系，光用第一条就够。
                  手机和电脑工作端的入口不一样，<a href={href('/use/#doubao')}>这里有完整说明</a>。
                </p>
              </div>
            </section>
          )
        }

        <div class="prose">
          <Content />
        </div>

        {
          c.persona?.world && (
            <section class="block" id="world">
              <h2 class="block__title">他所在的世界</h2>
              {c.persona.world.split(/\n{2,}/).map((para) => (
                <p class="world__p">{para.trim()}</p>
              ))}
              <p class="block__note">
                这一段已经并进上面那段提示词，复制粘贴的时候就一起带过去了 ——
                你不用另外准备任何东西。
              </p>
            </section>
          )
        }

        {
          c.requires.length > 0 && (
            <section class="block" id="prepare">
              <h2 class="block__title">使用前需要准备</h2>
              <ul class="list">
                {c.requires.map((r) => (
                  <li>{r}</li>
                ))}
              </ul>

              <div class="notice">
                <p class="notice__t">这两个字看着唬人，其实你不用准备</p>
                <p>
                  「世界书」是角色扮演客户端里的一个文件 ——
                  一份按关键词自动触发的背景设定，让角色知道地名、门派、规矩这些事。
                  它本来是要装进软件里的，用豆包和 DeepSeek 的人根本打不开它。
                </p>
                {c.persona?.world ? (
                  <p>
                    <strong>在豆包或 DeepSeek 里没有这个东西，也不需要。</strong>
                    这个世界的设定已经写进上面那段提示词了 —— 你复制过去，他就知道那些地名和规矩。
                    要下载的那份卡片文件里也带着同一份内容，两边一样，不需要额外准备什么。
                  </p>
                ) : (
                  <p>
                    <strong>在豆包或 DeepSeek 里没有这个机制，你也不用去找它。</strong>
                    聊的时候如果他对某些地名、门派反应含糊，直接在对话里补一句就行，比如：<br
                    />
                    <em>（补充设定：你所在的门派每十年收一次外门弟子，我入门那年刚好是第十年）</em>
                  </p>
                )}
              </div>
            </section>
          )
        }

        {
          c.derivedFrom.length > 0 && (
            <section class="block">
              <h2 class="block__title">改编自</h2>
              <ul class="list">
                {c.derivedFrom.map((id) => (
                  <li>
                    <a href={href(`/c/${id}/`)}>{id}</a>
                  </li>
                ))}
              </ul>
              <p class="block__note">
                这张卡在原作基础上做了改编。二创请一并遵守原作者的授权条款。
              </p>
            </section>
          )
        }

        <!-- 卡片文件：进阶用法，给客户端用户 -->
        <section class="block get" id="get">
          <h2 class="block__title">还想把它存成一份文件？</h2>
          <p class="block__text">
            只在豆包或 DeepSeek 里聊的话，上面那一步做完就结束了，这里可以跳过。<br />
            下面这份文件是给「角色扮演客户端」用的 —— 比如 SillyTavern，
            那类软件能导入卡片、记住更长的对话。没有装的话不用管。
          </p>

          <ul class="sources">
            {
              genCardUrl && (
                <li class="sources__item">
                  <a class="sources__link" href={genCardUrl}>
                    <span class="sources__label">角色卡文件（由上面同一份人设生成）</span>
                    <span class="sources__type">站内生成</span>
                  </a>
                </li>
              )
            }
            {
              c.source.map((s) => (
                <li class="sources__item">
                  <a class="sources__link" href={s.url} rel="noopener nofollow">
                    <span class="sources__label">{s.label ?? SOURCE_LABELS[s.type] ?? '下载'}</span>
                    <span class="sources__type">{SOURCE_LABELS[s.type] ?? s.type}</span>
                  </a>
                  {s.checksum && <code class="sources__sum">{s.checksum}</code>}
                </li>
              ))
            }
          </ul>

          <p class="block__note">
            下载后，在客户端里找「角色 / Characters」→「导入 / Import」，
            选中这个文件就进去了。卡片和提示词出自同一份人设，内容一致 —— 一个来源，两种用法。
          </p>
        </section>

        {
          related.length > 0 && (
            <section class="block">
              <h2 class="block__title">你可能也会喜欢</h2>
              <div class="related">
                {related.map(({ entry: e }, i) => (
                  <CharacterCard
                    id={e.id}
                    name={e.data.name}
                    tagline={e.data.tagline}
                    creator={e.data.creator}
                    tags={e.data.tags}
                    cover={e.data.cover}
                    coverAlt={e.data.coverAlt}
                    coverStyle={e.data.coverStyle}
                    index={i}
                  />
                ))}
              </div>
            </section>
          )
        }

        <!-- 收录徽章 -->
        <section class="block">
          <h2 class="block__title">收录徽章</h2>
          <p class="block__text">
            如果你是创作者，把这枚徽章贴在你的主页或社交账号上，链接指回这一页。
          </p>
          <div class="badgebox">
            <img
              class="badgebox__img"
              src={badgeImg}
              alt={`灯下收录 · ${c.name}`}
              loading="lazy"
            />
            <button class="btn btn--ghost badgebox__btn" type="button" data-badge-copy>
              复制嵌入代码
            </button>
          </div>
          <pre class="badgebox__pre"><code data-badge-md>{badgeMd}</code></pre>
        </section>

        <footer class="report">
          <p>内容有问题？比如链接失效、署名错误、或侵犯了你的权益。</p>
          <a class="btn btn--ghost" href={issueUrl} rel="noopener">报告问题</a>
        </footer>
      </div>
    </div>
  </article>
</Base>

<script>
  const copyBtn = document.querySelector<HTMLButtonElement>('[data-badge-copy]');
  const badgeMd = document.querySelector<HTMLElement>('[data-badge-md]');

  copyBtn?.addEventListener('click', async () => {
    const text = badgeMd?.textContent ?? '';
    try {
      await navigator.clipboard.writeText(text);
      const old = copyBtn.textContent;
      copyBtn.textContent = '已复制';
      setTimeout(() => (copyBtn.textContent = old), 1500);
    } catch {
      // 剪贴板被拒时降级成选中
      const range = document.createRange();
      if (badgeMd) {
        range.selectNodeContents(badgeMd);
        const sel = getSelection();
        sel?.removeAllRanges();
        sel?.addRange(range);
      }
    }
  });

  // 复制角色提示词 —— 这是把角色带进豆包 / DeepSeek 的那一步
  const promptBtn = document.querySelector<HTMLButtonElement>('[data-prompt-copy]');
  const promptText = document.querySelector<HTMLElement>('[data-prompt-text]');

  promptBtn?.addEventListener('click', async () => {
    const text = promptText?.textContent ?? '';
    try {
      await navigator.clipboard.writeText(text);
      const old = promptBtn.textContent;
      promptBtn.textContent = '已复制，去粘贴吧';
      setTimeout(() => (promptBtn.textContent = old), 2200);
    } catch {
      // 剪贴板不可用时，展开内容让用户手动复制
      const details = promptText?.closest('details');
      if (details) details.open = true;
      if (promptText) {
        const range = document.createRange();
        range.selectNodeContents(promptText);
        const sel = getSelection();
        sel?.removeAllRanges();
        sel?.addRange(range);
      }
    }
  });

  // 换个 App 就换一套步骤 —— 豆包和 DeepSeek 的入口完全不一样
  const appBtns = document.querySelectorAll<HTMLButtonElement>('[data-app]');
  const appPanels = document.querySelectorAll<HTMLElement>('[data-app-panel]');

  appBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const app = btn.dataset.app;
      appBtns.forEach((b) => b.classList.toggle('is-on', b === btn));
      appPanels.forEach((p) => {
        p.hidden = p.dataset.appPanel !== app;
      });
    });
  });
</script>

<style>
  .detail {
    padding-top: 26px;
  }

  .crumb {
    display: flex;
    gap: 8px;
    font-size: 12.5px;
    color: var(--ink-faint);
    margin-bottom: 22px;
  }

  .crumb a:hover {
    color: var(--accent);
  }

  .detail__grid {
    display: grid;
    gap: 30px;
  }

  @media (min-width: 900px) {
    .detail__grid {
      grid-template-columns: 292px 1fr;
      gap: 52px;
      align-items: start;
    }

    .detail__side {
      position: sticky;
      top: 84px;
    }
  }

  .detail__cta {
    width: 100%;
    margin-top: 16px;
  }

  /* —— 信息表 —— */
  .facts {
    margin: 22px 0 0;
    border-top: 1px solid var(--hairline);
  }

  .facts__row {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 0;
    border-bottom: 1px solid var(--hairline);
    font-size: 13px;
  }

  .facts__row dt {
    color: var(--ink-muted);
    flex-shrink: 0;
  }

  .facts__row dd {
    margin: 0;
    text-align: right;
    color: var(--ink-soft);
    word-break: break-word;
  }

  .facts__row dd a:hover {
    color: var(--accent);
  }

  /* —— 标题区 —— */
  .detail__name {
    font-size: clamp(28px, 4.4vw, 40px);
    line-height: 1.28;
  }

  .detail__tagline {
    margin-top: 12px;
    font-size: 16px;
    line-height: 1.75;
    color: var(--ink-soft);
    max-width: 40ch;
  }

  .detail__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    padding: 0;
    margin: 18px 0 0;
  }

  /* —— 开场白 —— */
  .opening {
    margin-top: 30px;
    padding: 22px 24px;
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-left: 3px solid var(--accent);
    border-radius: var(--r-md);
  }

  .opening__label {
    font-size: 12px;
    letter-spacing: 0.14em;
    color: var(--accent);
    margin-bottom: 10px;
  }

  .opening__quote {
    margin: 0;
    font-family: var(--font-display);
    font-size: 16.5px;
    line-height: 1.8;
    color: var(--ink);
    text-wrap: pretty;
  }

  .opening__note {
    margin-top: 12px;
    font-size: 12px;
    color: var(--ink-faint);
  }

  /* —— 正文区块 —— */
  .detail__main > .prose {
    margin-top: 34px;
  }

  .block {
    margin-top: 44px;
    padding-top: 30px;
    border-top: 1px solid var(--hairline);
  }

  .block__title {
    font-size: 16px;
    margin-bottom: 16px;
  }

  .block__text {
    font-size: 14.5px;
    line-height: 1.85;
    color: var(--ink-soft);
    max-width: 52ch;
  }

  .block__note {
    margin-top: 12px;
    font-size: 12.5px;
    color: var(--ink-muted);
    line-height: 1.7;
  }

  /* 他所在的世界 —— 世界观直接摊开给读者看 */
  .world__p {
    font-size: 14.5px;
    line-height: 1.9;
    color: var(--ink-soft);
    max-width: 52ch;
  }

  .world__p + .world__p {
    margin-top: 12px;
  }

  /* 卡片下载区：正文与列表之间的呼吸 */
  .get .sources {
    margin-top: 20px;
  }

  .list {
    margin: 0;
    padding-left: 1.2em;
    font-size: 14.5px;
    line-height: 1.9;
    color: var(--ink-soft);
  }

  .list a {
    color: var(--accent);
  }

  /* —— 三步指引 —— */
  .steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 26px;
  }

  .steps__item {
    display: flex;
    gap: 14px;
  }

  .steps__num {
    flex-shrink: 0;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent-deep);
    font-size: 13px;
    font-weight: 600;
    display: grid;
    place-items: center;
    margin-top: 1px;
  }

  .steps__title {
    font-size: 14.5px;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 8px;
  }

  .steps__text {
    font-size: 14.5px;
    line-height: 1.8;
    color: var(--ink-soft);
  }

  .steps__note {
    margin-top: 10px;
    font-size: 12.5px;
    color: var(--ink-muted);
    line-height: 1.7;
  }

  /* —— 来源列表 —— */
  .sources {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .sources__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 16px;
    background: var(--surface);
    border: 1px solid var(--hairline-strong);
    border-radius: var(--r-md);
    font-size: 14px;
    transition: border-color 0.16s ease, color 0.16s ease;
  }

  .sources__link:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .sources__label {
    font-weight: 500;
  }

  .sources__type {
    font-size: 11.5px;
    color: var(--ink-faint);
    white-space: nowrap;
  }

  .sources__sum {
    display: block;
    margin-top: 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-faint);
    word-break: break-all;
  }

  /* —— 相关推荐 —— */
  .related {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 16px;
  }

  /* —— 举报 —— */
  .report {
    margin-top: 52px;
    padding-top: 24px;
    border-top: 1px solid var(--hairline);
    font-size: 13px;
    color: var(--ink-muted);
  }

  .report .btn {
    margin-top: 14px;
  }

  /* —— 收录徽章 —— */
