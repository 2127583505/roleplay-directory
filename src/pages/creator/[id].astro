---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CharacterCard from '../../components/CharacterCard.astro';
import { href } from '../../consts';

export async function getStaticPaths() {
  const entries = await getCollection('characters');
  const names = [...new Set(entries.map((e) => e.data.creator))];
  return names.map((name) => ({ params: { id: name }, props: { name } }));
}

const { name } = Astro.props;
const all = await getCollection('characters');

const mine = all
  .filter((e) => e.data.creator === name)
  .sort((a, b) => (b.data.updated?.getTime() ?? 0) - (a.data.updated?.getTime() ?? 0));

// 创作者主页链接：取第一张卡上填了的
const homepage = mine.find((e) => e.data.creatorUrl)?.data.creatorUrl;

// 汇总标签，让访问者快速了解这位创作者的风格
const tagFreq = new Map<string, number>();
for (const e of mine) {
  for (const t of e.data.tags) tagFreq.set(t, (tagFreq.get(t) ?? 0) + 1);
}
const topTags = [...tagFreq.entries()].sort((a, b) => b[1] - a[1]).slice(0, 8);
---

<Base title={name} description={`${name} 创作的角色卡`}>
  <section class="wrap creator">
    <nav class="crumb" aria-label="面包屑">
      <a href={href('/')}>全部角色</a>
      <span aria-hidden="true">/</span>
      <span>{name}</span>
    </nav>

    <header class="creator__head">
      <h1 class="creator__name">{name}</h1>
      <p class="creator__meta">
        {mine.length} 张角色卡
        {
          homepage && (
            <>
              <span class="creator__sep" aria-hidden="true">·</span>
              <a class="creator__link" href={homepage} rel="noopener">个人主页</a>
            </>
          )
        }
      </p>
      {
        topTags.length > 0 && (
          <ul class="creator__tags">
            {topTags.map(([t, n]) => (
              <li class="pill">
                {t}
                <span class="creator__tagcount">{n}</span>
              </li>
            ))}
          </ul>
        )
      }
    </header>

    <div class="grid">
      {
        mine.map((e, i) => (
          <CharacterCard
            id={e.id}
            name={e.data.name}
            tagline={e.data.tagline}
            creator={e.data.creator}
            tags={e.data.tags}
            cover={e.data.cover}
            coverAlt={e.data.coverAlt}
            coverStyle={e.data.coverStyle}
            index={i}
          />
        ))
      }
    </div>

    <aside class="notice">
      <p>
        这张名单来自角色卡里填写的创作者署名。如果你发现自己的作品被错误署名，
        或者想补充个人主页链接，欢迎提一个 Pull Request 修改对应文件。
      </p>
    </aside>
  </section>
</Base>

<style>
  .creator {
    padding-top: 26px;
  }

  .crumb {
    display: flex;
    gap: 8px;
    font-size: 12.5px;
    color: var(--ink-faint);
    margin-bottom: 24px;
  }

  .crumb a:hover {
    color: var(--accent);
  }

  .creator__head {
    padding-bottom: 26px;
    border-bottom: 1px solid var(--hairline);
    margin-bottom: 28px;
  }

  .creator__name {
    font-size: clamp(26px, 4vw, 36px);
    line-height: 1.3;
  }

  .creator__meta {
    margin-top: 10px;
    font-size: 13.5px;
    color: var(--ink-muted);
  }

  .creator__sep {
    margin-inline: 8px;
  }

  .creator__link {
    color: var(--accent);
  }

  .creator__link:hover {
    text-decoration: underline;
  }

  .creator__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    padding: 0;
    margin: 18px 0 0;
  }

  .creator__tagcount {
    margin-left: 6px;
    font-size: 11px;
    color: var(--ink-faint);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 18px;
  }

  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(auto-fill, minmax(216px, 1fr));
      gap: 22px;
    }
  }

  @media (min-width: 1024px) {
    .grid {
      grid-template-columns: repeat(auto-fill, minmax(228px, 1fr));
      gap: 26px;
    }
  }

  .notice {
    margin-top: 44px;
    padding: 20px 22px;
    background: var(--surface-sunk);
    border-radius: var(--r-md);
    font-size: 13px;
    line-height: 1.8;
    color: var(--ink-muted);
    max-width: 62ch;
  }
</style>
